# ==============================================================================
# Slotbook Environment Configuration Template
# Copy to .env and populate secrets before running locally or via Docker Compose.
# NEVER commit .env or real credentials.
# ==============================================================================

# Application environment: development | test | production
APP_ENV=development

# Public canonical application origin URL (used for links & CSRF origin checks)
APP_URL=http://localhost:3000

# PostgreSQL connection settings (used by Docker Compose & local scripts)
POSTGRES_DB=slotbook
POSTGRES_USER=slotbook
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=

# Generate a 32+ byte random secret (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Resend API key & sender address
RESEND_API_KEY=
EMAIL_FROM=Slotbook <noreply@example.com>

# Development-only demo host seeding (strictly refused when APP_ENV=production)
ALLOW_DEMO_SEED=false
DEMO_HOST_EMAIL=
DEMO_HOST_PASSWORD=

# Optional Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
