# ==============================================================================
# Slotbook Environment Configuration Template
# Copy to .env for local development. NEVER commit .env or real credentials.
# ==============================================================================

# Application environment: development | test | production
APP_ENV=development

# Public canonical application origin URL (used for links & CSRF origin checks)
APP_URL=http://localhost:3000

# Optional in Phase 1A foundation; required when database phase is activated
# Example format: postgresql://USER:PASSWORD@localhost:5432/slotbook
DATABASE_URL=

# Optional in Phase 1A foundation; required when authentication phase is activated
# Generate a 32+ byte random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional in Phase 1A foundation; required in production email delivery mode
RESEND_API_KEY=

# Sender address used for transactional booking emails
EMAIL_FROM=Slotbook <noreply@example.com>

# Optional Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

